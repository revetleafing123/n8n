# Copy this to .env (gitignored) and fill in locally for testing.
# For the real deploy, paste these into the Hostless dashboard instead —
# mark N8N_ENCRYPTION_KEY and DB_POSTGRESDB_PASSWORD as write-only.

# --- Generate once, never change ---
# openssl rand -hex 16
N8N_ENCRYPTION_KEY=

# --- Database (Neon / freebase / any managed Postgres) ---
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=
DB_POSTGRESDB_USER=
DB_POSTGRESDB_PASSWORD=
DB_POSTGRESDB_SSL_ENABLED=true
DB_POSTGRESDB_POOL_SIZE=5

# --- Public URL (must match the deployed hostname) ---
N8N_PROTOCOL=https
N8N_HOST=
WEBHOOK_URL=
N8N_PROXY_HOPS=1

# --- Housekeeping ---
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
N8N_RUNNERS_ENABLED=true
N8N_DIAGNOSTICS_ENABLED=false
